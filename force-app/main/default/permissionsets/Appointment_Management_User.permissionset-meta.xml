<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Appointment Management User</label>
    <description>Grants access to the Appointment object and its fields for agents and administrators using the Appointment Management Assistant.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Appointment__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Appointment__c.Contact__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Appointment__c.Appointment_Date_Time__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Appointment__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Appointment__c.Service_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Appointment__c.Notes__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>AppointmentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ManageAppointmentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
