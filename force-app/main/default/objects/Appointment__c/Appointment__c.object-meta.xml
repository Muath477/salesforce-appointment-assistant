<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores a customer appointment: who it is for, when, its status, and the type of service. Central object for the Appointment Management Assistant.</description>
    <label>Appointment</label>
    <pluralLabel>Appointments</pluralLabel>
    <nameField>
        <label>Appointment Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
        <displayFormat>APT-{00000}</displayFormat>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>true</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableHistory>true</enableHistory>
    <visibility>Public</visibility>
</CustomObject>
