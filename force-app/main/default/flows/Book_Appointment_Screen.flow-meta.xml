<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Screen Flow that provides the user-facing booking interface. Collects the appointment date/time and service type, validates that the date is in the future, creates the Appointment record, and confirms the appointment number back to the user. Launched from the Appointment Management app, and from a Contact record page (where it links the appointment to that contact automatically).</description>
    <environments>Default</environments>
    <interviewLabel>Book Appointment Screen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Book Appointment Screen</label>
    <processType>Flow</processType>
    <choices>
        <name>Choice_Consultation</name>
        <choiceText>Consultation</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Consultation</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Follow_up</name>
        <choiceText>Follow-up</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Follow-up</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Other</name>
        <choiceText>Other</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Support</name>
        <choiceText>Support</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Support</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Is_Date_In_Future</name>
        <label>Is Date In Future?</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Past_Date_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Date is in the past</defaultConnectorLabel>
        <rules>
            <name>Date_Is_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AppointmentDateTime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Appointment_Record</targetReference>
            </connector>
            <label>Date Is Valid</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Appointment_Record</name>
        <label>Create Appointment Record</label>
        <locationX>50</locationX>
        <locationY>407</locationY>
        <assignRecordIdToReference>varAppointmentId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Created_Appointment</targetReference>
        </connector>
        <inputAssignments>
            <field>Appointment_Date_Time__c</field>
            <value>
                <elementReference>AppointmentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>varContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>AppointmentNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Type__c</field>
            <value>
                <elementReference>ServiceType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </inputAssignments>
        <object>Appointment__c</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Created_Appointment</name>
        <label>Get Created Appointment</label>
        <locationX>50</locationX>
        <locationY>527</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirmation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAppointmentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Appointment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Booking_Details</name>
        <label>Book an Appointment</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <allowBack>false</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Is_Date_In_Future</targetReference>
        </connector>
        <fields>
            <name>BookingIntro</name>
            <fieldText>&lt;p&gt;Tell us when you would like to come in and what you need help with.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>AppointmentDateTime</name>
            <dataType>DateTime</dataType>
            <fieldText>Appointment Date/Time</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>ServiceType</name>
            <choiceReferences>Choice_Consultation</choiceReferences>
            <choiceReferences>Choice_Follow_up</choiceReferences>
            <choiceReferences>Choice_Support</choiceReferences>
            <choiceReferences>Choice_Other</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Choice_Consultation</defaultSelectedChoiceReference>
            <fieldText>Service Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>AppointmentNotes</name>
            <fieldText>Anything we should know? (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Past_Date_Error</name>
        <label>Please Choose a Future Date</label>
        <locationX>314</locationX>
        <locationY>407</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Booking_Details</targetReference>
        </connector>
        <fields>
            <name>PastDateMessage</name>
            <fieldText>&lt;p&gt;The date and time you chose has already passed. Please go back and pick a future date and time.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Confirmation</name>
        <label>Appointment Confirmed</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ConfirmationMessage</name>
            <fieldText>&lt;p&gt;&lt;b&gt;You are booked.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Reference: {!Get_Created_Appointment.Name}&lt;/p&gt;&lt;p&gt;Service: {!Get_Created_Appointment.Service_Type__c}&lt;/p&gt;&lt;p&gt;When: {!Get_Created_Appointment.Appointment_Date_Time__c}&lt;/p&gt;&lt;p&gt;Please quote the reference above if you need to reschedule or cancel.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Booking_Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varAppointmentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Set automatically when the Flow is launched from a Contact record page, so the appointment is linked to that customer. Left empty when the Flow is launched standalone.</description>
        <name>varContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
