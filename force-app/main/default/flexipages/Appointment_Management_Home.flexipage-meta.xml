<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Home page for the Appointment Management app. Hosts the custom Upcoming Appointments Lightning Web Component so an administrator sees what is coming up the moment they open the app.</description>
    <flexiPageRegions>
        <name>main</name>
        <type>Region</type>
        <itemInstances>
            <componentInstance>
                <componentName>upcomingAppointments</componentName>
                <componentInstanceProperties>
                    <name>maxRows</name>
                    <value>10</value>
                </componentInstanceProperties>
                <identifier>upcomingAppointments1</identifier>
            </componentInstance>
        </itemInstances>
    </flexiPageRegions>
    <masterLabel>Appointment Management Home</masterLabel>
    <template>
        <name>flexipage:defaultHomeTemplate</name>
    </template>
    <type>HomePage</type>
</FlexiPage>
